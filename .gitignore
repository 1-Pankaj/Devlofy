.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.keystore
*.mobileprovision

# Metro
.metro-health-check*

# debug & package manager logs
npm-debug.*
yarn-debug.*
yarn-error.*
pnpm-debug.log*
lerna-debug.log*

# Environment & secrets
.env
.env*.local
!.env.example

# IDEs & Editors
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-workspace
*.sublime-project
# VS Code: keep shared config, ignore personal workspace state
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Operating System files
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
*.pem

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# typescript
*.tsbuildinfo

# testing & coverage
coverage/
*.lcov
.nyc_output/

# linter & tool caches
.eslintcache
.stylelintcache

# Python (tools/brand scripts)
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.venv/
venv/
env/

example

# regenerable knowledge-graph output (run: graphify update . && graphify export obsidian)
graphify-out/

# Obsidian vault state — workspace layout churns on every window move
.obsidian/

# @generated expo skills start
.agents/skills/expo-sqlite
.claude/skills/expo-sqlite
# @generated expo skills end

# loom: the live session handoff is local state, not project history
docs/handoffs/latest.md

# tsc emits beside the source when a single file is compiled without --outDir;
# src/ is TypeScript only, so any .js there is an artifact, never a source file
/src/**/*.js
