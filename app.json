{
  "expo": {
    "name": "Devlofy",
    "slug": "devlofy",
    "version": "0.8.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "devlofy",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F5F2FB",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "CADisableMinimumFrameDurationOnPhone": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#4B5AA0",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F2FB",
          "dark": {
            "backgroundColor": "#131318"
          }
        }
      ],
      "expo-sqlite",
      "expo-image",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "comment": "githubClientId is the public client ID of the user's own GitHub OAuth App (Device Flow enabled). Empty = on-device sign-in is hidden and a pasted token is the only way in. A client ID is public and safe to commit; a client secret is not, and device flow never needs one.",
      "githubClientId": "Ov23lil9vqHnIZFi1QWM"
    }
  }
}
