root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# Trailing spaces are two-space line breaks in markdown.
trim_trailing_whitespace = false

[*.py]
indent_size = 4

[*.{yml,yaml}]
indent_size = 2
